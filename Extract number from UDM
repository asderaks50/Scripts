import re
import json
from SiemplifyAction import SiemplifyAction
from SiemplifyUtils import output_handler
from ScriptResult import EXECUTION_STATE_COMPLETED, EXECUTION_STATE_FAILED

@output_handler
def main():
    siemplify = SiemplifyAction()
    siemplify.script_name = "Extract Numbers from UDM Field"
    siemplify.LOGGER.info("-------------- Main - Param Init --------------")

    try:
        # Get UDM field as a plain string
        udm_field_value = siemplify.extract_action_param("UDM_Field", print_value=True)

        if not udm_field_value:
            raise ValueError("UDM_Field parameter is empty.")

        # Ensure we work with string
        udm_field_value = str(udm_field_value)

        # Extract numbers from the string
        numbers = [int(num) for num in re.findall(r"\d+", udm_field_value)]

        # Prepare JSON result
        numbers_json = json.dumps({"Extracted_Numbers": numbers})

        output_message = f"Extracted numbers in JSON: {numbers_json}"
        siemplify.LOGGER.info(output_message)

        # End action
        siemplify.end(output_message, numbers_json, EXECUTION_STATE_COMPLETED)

    except Exception as e:
        error_message = f"Error extracting numbers: {e}"
        siemplify.LOGGER.error(error_message)
        siemplify.end(error_message, "{}", EXECUTION_STATE_FAILED)

if __name__ == "__main__":
    main()
