from SiemplifyAction import SiemplifyAction
from SiemplifyUtils import unix_now, output_handler
from ScriptResult import EXECUTION_STATE_COMPLETED, EXECUTION_STATE_FAILED
import json
import csv
import os
from datetime import datetime, timezone

# Constants
TMP_DIR = "/tmp/"
SCRIPT_START = datetime.now(timezone.utc)

def verify_list_of_dict(var):
    """Ensure the input is a list of dictionaries."""
    if isinstance(var, dict):  
        return [var]  # Convert a single dictionary to a list
    if isinstance(var, list) and all(isinstance(v, dict) for v in var):
        return var
    return None

def make_hashable(value):
    """Recursively convert lists to tuples and dictionaries to frozensets so they become hashable."""
    if isinstance(value, dict):
        return frozenset((k, make_hashable(v)) for k, v in value.items())  # Convert dict → frozenset
    elif isinstance(value, list):
        return tuple(make_hashable(v) for v in value)  # Convert list → tuple
    return value  

def remove_duplicates(data):
    """Remove duplicate dictionaries from a list."""
    seen = set()
    unique_data = []
    for d in data:
        hashed = frozenset((k, make_hashable(v)) for k, v in d.items())
        if hashed not in seen:
            seen.add(hashed)
            unique_data.append(d)
    return unique_data

def create_csv_file(file_path, data, headers, quoting, siemplify):
    """Create a CSV file from a list of dictionaries and attach it to Siemplify."""
    try:
        with open(file_path, mode="w", newline="", encoding="utf-8") as f:
            writer = csv.DictWriter(f, fieldnames=headers, quoting=quoting, extrasaction="ignore")
            writer.writeheader()
            writer.writerows(data)

        with open(file_path, "rb") as file:
            file_contents = file.read()

        # Attach the CSV file to Siemplify
        siemplify.result.add_attachment(os.path.basename(file_path), file_contents)
        siemplify.LOGGER.info(f"CSV file {file_path} successfully created and attached.")
        
        return file_path

    except Exception as e:
        siemplify.LOGGER.error(f"Error creating CSV file: {str(e)}")
        raise

@output_handler
def main():
    siemplify = SiemplifyAction()
    
    # Extract input parameters
    json_input = siemplify.extract_action_param("json", print_value=True)
    quoting_input = siemplify.extract_action_param("quoting", default_value="Minimal")
    file_name = siemplify.extract_action_param("file_name", default_value="output")

    # Default quoting mode is minimal
    quoting_map = {"All": csv.QUOTE_ALL, "Minimal": csv.QUOTE_MINIMAL, "Nonnumeric": csv.QUOTE_NONNUMERIC}
    quoting = quoting_map.get(quoting_input.title(), csv.QUOTE_MINIMAL)

    status = EXECUTION_STATE_COMPLETED
    output_message = "CSV file successfully created."
    result_value = True

    try:
        # Validate JSON input
        if not json_input.strip():
            raise ValueError("JSON input is empty. Please provide valid JSON data.")

        # Parse JSON input safely
        try:
            data = json.loads(json_input)
        except json.JSONDecodeError as e:
            raise ValueError(f"Invalid JSON format: {str(e)}")

        data = verify_list_of_dict(data)
        if data is None:
            raise ValueError("Expected JSON input to be a list of dictionaries.")

        # Remove duplicates
        unique_data = remove_duplicates(data)
        headers = {h for d in unique_data for h in d.keys()}

        if unique_data:
            # Generate a timestamped CSV file name
            csv_file_name = f"{file_name}_{SCRIPT_START.strftime('%Y%m%d_%H%M%S')}.csv"
            csv_file_path = os.path.join(TMP_DIR, csv_file_name)

            # Create CSV file
            create_csv_file(csv_file_path, unique_data, headers, quoting, siemplify)

            output_message = f"CSV file {csv_file_name} has been successfully created and stored at {csv_file_path}."
            result_value = csv_file_path
        else:
            output_message = "No valid data to write to CSV."
            result_value = None

        siemplify.result.add_result_json({"csv_file": result_value})

    except Exception as e:
        status = EXECUTION_STATE_FAILED
        output_message = f"Error: {str(e)}"
        result_value = ""

    siemplify.LOGGER.info(f"\nStatus: {status}\nResult Value: {result_value}\nOutput Message: {output_message}")
    siemplify.end(output_message, result_value, status)

if __name__ == "__main__":
    main()
