from SiemplifyAction import SiemplifyAction
from SiemplifyUtils import unix_now, convert_unixtime_to_datetime, output_handler
from ScriptResult import EXECUTION_STATE_COMPLETED, EXECUTION_STATE_FAILED, EXECUTION_STATE_TIMEOUT
import json, csv
from io import StringIO

def verify_list_of_dict(var):
    """Ensure the input is a list of dictionaries."""
    if isinstance(var, dict):  # Convert single dictionary to a list
        return [var]
    if isinstance(var, list) and all(isinstance(v, dict) for v in var):
        return var
    return None

def hashable_dict(d):
    """Convert dictionary values that are lists into tuples so they become hashable."""
    return {k: tuple(v) if isinstance(v, list) else v for k, v in d.items()}

def remove_duplicates(data):
    """Remove duplicate dictionaries from a list (handling unhashable types)."""
    seen = set()
    unique_data = []
    for d in data:
        hashed = frozenset(hashable_dict(d).items())  # Use frozenset instead of tuple
        if hashed not in seen:
            seen.add(hashed)
            unique_data.append(d)
    return unique_data

@output_handler
def main():
    siemplify = SiemplifyAction()
    
    json_input = siemplify.extract_action_param("json", print_value=True)
    quoting_input = siemplify.extract_action_param("quoting")
    file_name = siemplify.extract_action_param("file_name")
    
    quoting_map = {"All": csv.QUOTE_ALL, "Minimal": csv.QUOTE_MINIMAL, "Nonnumeric": csv.QUOTE_NONNUMERIC}
    quoting = quoting_map.get(quoting_input.title(), csv.QUOTE_MINIMAL)
    
    status = EXECUTION_STATE_COMPLETED
    output_message = "Completed"
    result_value = True
    
    try:
        data = json.loads(json_input)  # Convert JSON string to Python object
        data = verify_list_of_dict(data)  # Ensure it's a list of dictionaries
        
        if data is None:
            raise ValueError("Expected JSON input to be a list of dictionaries.")

        # Remove duplicate dictionaries
        unique_data = remove_duplicates(data)
        
        headers = {h for d in unique_data for h in d.keys()}
        output = StringIO()
        
        writer = csv.DictWriter(output, fieldnames=headers, quoting=quoting, extrasaction='ignore')
        writer.writeheader()
        for row in unique_data:
            writer.writerow(row)
        
        result_value = output.getvalue()
        
        escaped_chars = {'\n': '\\n', '\r': '\\r', '\t': '\\t'}
        result_value = ''.join(escaped_chars.get(char, char) for char in result_value)
        
        siemplify.result.add_result_json({file_name + ".csv": result_value})
    
    except Exception as e:
        status = EXECUTION_STATE_FAILED
        output_message = f"Error: {e}"
        result_value = False
    
    siemplify.LOGGER.info("\n status: {}\n result_value: {}\n output_message: {}".format(status, result_value, output_message))
    siemplify.end(output_message, result_value, status)

if __name__ == "__main__":
    main()
